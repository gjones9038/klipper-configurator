# Cartographer V3 (STM32F042, 32 KiB flash): enable the LDC1612 eddy driver and
# trigger_analog (which Klipper's generic F042 test build disables), and drop
# features that board does not use so the firmware still fits.
CONFIG_WANT_I2C=y
CONFIG_WANT_LDC1612=y
CONFIG_WANT_TRIGGER_ANALOG=y
CONFIG_WANT_GPIO_BITBANGING=n
CONFIG_WANT_DISPLAYS=n
CONFIG_WANT_SOFTWARE_SPI=n
CONFIG_WANT_SOFTWARE_I2C=n
CONFIG_WANT_BUTTONS=n
CONFIG_WANT_TMCUART=n
CONFIG_WANT_PULSE_COUNTER=n
CONFIG_WANT_ADXL345=n
CONFIG_WANT_LIS2DW=n
CONFIG_WANT_MPU9250=n
CONFIG_WANT_ICM20948=n
CONFIG_WANT_BMI160=n
CONFIG_WANT_THERMOCOUPLE=n
CONFIG_WANT_SENSOR_ANGLE=n
CONFIG_WANT_HX71X=n
CONFIG_WANT_ADS1220=n
CONFIG_WANT_ADS131M0X=n
CONFIG_WANT_CS1237=n
CONFIG_WANT_NEOPIXEL=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
