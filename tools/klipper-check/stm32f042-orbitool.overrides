# Orbitool O2 / SO3 (STM32F042, 32 KiB flash): the features their vendor configs use
# (TMC2209 UART, LIS2DW accelerometer, neopixel, fan tachometers, filament buttons),
# with the rest dropped so the firmware fits.
CONFIG_WANT_TMCUART=y
CONFIG_WANT_LIS2DW=y
CONFIG_WANT_NEOPIXEL=y
CONFIG_WANT_PULSE_COUNTER=y
CONFIG_WANT_BUTTONS=y
CONFIG_WANT_GPIO_BITBANGING=n
CONFIG_WANT_DISPLAYS=n
CONFIG_WANT_SOFTWARE_SPI=n
CONFIG_WANT_SOFTWARE_I2C=n
CONFIG_WANT_I2C=n
CONFIG_WANT_ADXL345=n
CONFIG_WANT_MPU9250=n
CONFIG_WANT_ICM20948=n
CONFIG_WANT_BMI160=n
CONFIG_WANT_THERMOCOUPLE=n
CONFIG_WANT_SENSOR_ANGLE=n
CONFIG_WANT_HX71X=n
CONFIG_WANT_ADS1220=n
CONFIG_WANT_ADS131M0X=n
CONFIG_WANT_CS1237=n
CONFIG_WANT_LDC1612=n
CONFIG_WANT_TRIGGER_ANALOG=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
