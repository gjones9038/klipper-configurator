{
  "name": "klipper-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generate Klipper configs and wiring guides from component data",
  "scripts": {
    "generate": "node generator/cli.ts",
    "test": "node --test \"generator/test/*.test.ts\"",
    "validate-data": "python3 tools/validate.py --matrix",
    "klipper-check": "python3 -I tools/klipper_check.py --klipper .cache/klipper-check/klipper --dicts .cache/klipper-check/dicts --autotune .cache/klipper-check/autotune --toolchanger .cache/klipper-check/toolchanger --site .cache/klipper-check/site --ui-configs .cache/klipper-check/ui",
    "matrix": "node generator/test/write-matrix.ts out/matrix",
    "setup-klipper-check": "bash tools/setup_klipper_check.sh",
    "web:build": "node tools/build_web.ts",
    "web:dev": "node tools/build_web.ts --serve",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "typescript": "5.9"
  }
}
